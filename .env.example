# OxiqAI HRMS - Pipeline-2 Local Environment Template

# Core Orchestration Service Configurations
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
DEBUG=false

# PostgreSQL Database Connection (Used by Database MCP Server)
DATABASE_URL=postgresql://postgres:password@localhost:5432/oxiqai_recruitment_db

# LLM Providers Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# MCP Servers Command / Port Mappings (If running as network nodes)
DB_MCP_PORT=5001
CALENDAR_MCP_PORT=5002
NOTIFICATION_MCP_PORT=5003

# Google Workspace API Credentials (Used by Calendar and Meet MCPs)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/google-credentials.json
GOOGLE_CALENDAR_ID=primary

# SMTP Configuration (Used by Mail MCP Server)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=recruitment@oxiqai.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=recruitment@oxiqai.com

# Analytics and Telemetry (Future Observability)
OPENTELEMETRY_ENDPOINT=http://localhost:4317
