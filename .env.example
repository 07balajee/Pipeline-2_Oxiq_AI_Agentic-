# OxiqAI HRMS Recruitment Pipeline-2 Configuration
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
DEBUG=false

# Master & Microservice Worker URLs
MASTER_SERVICE_URL=http://127.0.0.1:8000
AGENT6_SERVICE_URL=http://127.0.0.1:8001
AGENT7_SERVICE_URL=http://127.0.0.1:8002
AGENT8_SERVICE_URL=http://127.0.0.1:8003

# Timeouts & Retries
AGENT_HTTP_TIMEOUT_SECONDS=30.0
HEALTH_HTTP_TIMEOUT_SECONDS=3.0
MAX_RETRY_ATTEMPTS=3

# Database & MCP Integration Settings
DATABASE_URL=postgresql://postgres:password@localhost:5432/oxiqai_recruitment_db
MCP_DB_MODE=mock                        # "mock" for unit tests | "real" for live Supabase MCP
MCP_DB_SERVER_PATH=mcp_server_extracted/MCP_recruitementDB_Server/server.py
MCP_DB_TRANSPORT=stdio                 # "stdio" | "http"
MCP_DB_HTTP_URL=http://127.0.0.1:8010

# API Credentials (mocked for development)
ANTHROPIC_API_KEY=mock-anthropic-key
OPENAI_API_KEY=mock-openai-key
