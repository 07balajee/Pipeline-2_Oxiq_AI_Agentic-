# pyenv
#   For a library or app, you might want to share your .python-version if you're
#   using pyenv and local version file (.python-version)
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if lock is generated on different OS it might fail.
# Pipfile.lock

# poetry
#   Poetry uses pyproject.toml and poetry.lock. It is recommended to commit poetry.lock.
# poetry.lock

# pdm
#   PDM stores project-wide configurations in .pdm.toml:
.pdm.toml
#   and local settings in .pdm-python.path of project root:
.pdm-python.path
